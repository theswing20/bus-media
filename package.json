{
  "name": "bus-media",
  "private": true,
  "version": "0.1.0",
  "description": "АП №1 — реклама и объявление остановок на бортовых компьютерах автобусов",
  "scripts": {
    "dev:server": "pnpm --filter @bus/server dev",
    "dev:admin": "pnpm --filter @bus/admin dev",
    "dev:player": "pnpm --filter @bus/player dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @bus/server prisma migrate dev",
    "db:studio": "pnpm --filter @bus/server prisma studio"
  },
  "devDependencies": { "typescript": "^5.6.3" },
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" }
}
