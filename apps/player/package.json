{
  "name": "@bus/player",
  "version": "0.1.0",
  "private": true,
  "description": "Бортовой плеер: реклама между остановками + объявление остановок (kk, ru) по GPS",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5174 && pnpm build:main && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "build:main": "esbuild src/main/index.ts src/main/preload.ts --bundle --platform=node --target=node20 --format=cjs --sourcemap --outdir=dist/main --external:electron --external:serialport --external:@serialport/*",
    "build": "tsc -p tsconfig.main.json --noEmit && pnpm build:main && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron .",
    "package:linux": "pnpm build && electron-builder --linux --arm64 --x64"
  },
  "dependencies": {
    "@bus/shared": "workspace:*",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "esbuild": "0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "kz.remissonsoft.busplayer",
    "productName": "BusPlayer",
    "files": [
      "dist/**"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "AudioVideo"
    }
  }
}
