# --- server ---
DATABASE_URL=postgresql://bus:bus@localhost:5432/bus_media
PORT=4000
ADMIN_TOKEN=change-me-admin-token
PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=./uploads

# TTS для озвучки остановок (Azure Speech, голоса kk-KZ и ru-RU)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
TTS_VOICE_KK=kk-KZ-AigulNeural
TTS_VOICE_RU=ru-RU-SvetlanaNeural

# --- player (бортовой компьютер) ---
PLAYER_SERVER_URL=http://localhost:4000
PLAYER_DEVICE_ID=
PLAYER_DEVICE_TOKEN=
PLAYER_GPS=gpsd            # gpsd | serial | mock
PLAYER_GPS_SERIAL=/dev/ttyUSB1
PLAYER_CACHE_DIR=./cache
# Датчики подсчёта пассажиров: off | mock | http
# http — датчики шлют POST http://<борт>:PLAYER_PAX_PORT/count  {"door":1,"in":2,"out":0}
PLAYER_PAX=off
PLAYER_PAX_PORT=8787
